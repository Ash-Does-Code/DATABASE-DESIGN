-- ALTER COMMANDS
-- GENERAL SYNTAX

ALTER TABLE [IF EXISTS] table_name
action [, action ...];

action can be:

ADD COLUMN
DROP COLUMN
RENAME COLUMN
ALTER COLUMN
ADD CONSTRAINT
DROP CONSTRAINT
RENAME TO
SET SCHEMA
OWNER TO


ALTER TABLE product ADD COLUMN price INT DEFAULT 1;
ALTER TABLE product DROP COLUMN price;

ALTER TABLE employees
DROP COLUMN IF EXISTS email;


ALTER TABLE PRODUCT
RENAME TO PROD;
SELECT * FROM PROD;

-- alter data type
ALTER COLUMN salary TYPE NUMERIC(10,2);

--add default value to an existing col
ALTER TABLE PRODUCT
ALTER COLUMN price SET DEFAULT 300;
--drop default
ALTER COLUMN price DROP DEFAULT;

ALTER TABLE PRODUCT
ALTER COLUMN price SET NOT NULL;
--drop not null
ALTER COLUMN price DROP NOT NULL;

--keys
ALTER TABLE product
--add pk
ADD CONSTRAINT pk PRIMARY KEY (name)
--drop pk
DROP CONSTRAINT pk

--add fk
ADD CONSTRAINT fk 
FOREIGN KEY(colA) REFERENCES table(colB);
--drop fk
DROP CONSTRAINT fk;

--unique
ADD CONSTRAINT uq_email
UNIQUE (email);
DROP CONSTRAINT uq_email;

--check
ADD CONSTRAINT chk_salary
CHECK (salary > 0);
DROP CONSTRAINT chk_salary;


SELECT * FROM Product;



--delete
DELETE FROM employees
WHERE department = 'HR';
--delete all rows:
DELETE FROM employees;

--truncate
TRUNCATE TABLE employees;

--drop
DROP TABLE IF EXISTS employees;




dtypes:

INT
BIGINT
DECIMAL
VARCHAR
TEXT
DATE
TIME
TIMESTAMP
BOOLEAN


constraints:
PRIMARY KEY
FOREIGN KEY
NOT NULL
UNIQUE
DEFAULT
CHECK

table lvl + col lvl constraints in create statements:
CREATE TABLE employees (
    id INT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(255) UNIQUE,
    age INT CHECK (age >= 18),
    salary DECIMAL(10,2) CHECK (salary > 0),
    is_active BOOLEAN DEFAULT TRUE,
    joining_date DATE NOT NULL,
    department_id INT,

    FOREIGN KEY (department_id)
        REFERENCES departments(id)
);

naming constraints:
CREATE TABLE users (
    id INT,
    email VARCHAR(255),

    CONSTRAINT pk_users
        PRIMARY KEY (id),

    CONSTRAINT uq_users_email
        UNIQUE (email)
);
